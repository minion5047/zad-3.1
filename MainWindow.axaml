<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="460"
        Width="520" Height="460"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        x:Class="minutnik.MainWindow"
        Title="Minutnik">
    <Border Padding="24">
        <StackPanel Spacing="16" VerticalAlignment="Center">
            <TextBlock Name="PhaseText"
                       Text="Faza: Praca"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock Name="TimerText"
                       Text="25:00"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Center">
                <Button Name="StartPauseButton"
                        Content="Start"
                        Width="120"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnStartPauseClick" />
                <Button Name="ResetButton"
                        Content="Reset"
                        Width="120"
                        Height="38"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnResetClick" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" MaxWidth="360" HorizontalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Czas pracy (min):" FontSize="13" />
                    <TextBox Name="WorkMinutesInput"
                             Text="25"
                             TextChanged="OnDurationChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Czas przerwy (min):" FontSize="13" />
                    <TextBox Name="BreakMinutesInput"
                             Text="5"
                             TextChanged="OnDurationChanged" />
                </StackPanel>
            </Grid>

            <TextBlock Name="StatusMessageText"
                       Text=""
                       FontSize="12"
                       Foreground="IndianRed"
                       HorizontalAlignment="Center"
                       IsVisible="False" />

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Name="CyclesText"
                           Text="Skończone cykle: 0"
                           FontSize="16"
                           FontWeight="Medium"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
